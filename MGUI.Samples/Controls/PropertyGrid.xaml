<Window xmlns="clr-namespace:MGUI.Core.UI.XAML;assembly=MGUI.Core"
    Left="440" Top="20" MinHeight="0" Width="560" Height="580" TitleText="PropertyGrid" Padding="10">
    <Window.Styles>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style Name="Header1" TargetType="TextBlock">
            <Setter Property="IsBold" Value="True" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Height" Value="2" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Opacity" Value="0.25" />
        </Style>
    </Window.Styles>

    <StackPanel Orientation="Vertical" Spacing="8">
        <TextBlock StyleNames="Header1" Text="PropertyGrid:" HorizontalAlignment="Center" />
        <Separator />
        <TextBlock WrapText="True"
                   Text="This sample keeps the PropertyGrid refreshed every frame, animates grouped values in place, includes a Manual category that does not update in real time, and lets you switch between the built-in Dark_Blue and Dark themes." />

        <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Name="SwapObjectButton" Content="Swap Object" />
            <Button Name="MutateObjectButton" Content="External Mutate" />
            <TextBlock Name="ActiveObjectLabel" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Name="UseDarkBlueThemeButton" Content="Dark_Blue" />
            <Button Name="UseDarkThemeButton" Content="Dark" />
            <TextBlock Name="ThemeStatusLabel" VerticalAlignment="Center" />
        </StackPanel>

        <PropertyGrid Name="Inspector" Height="420" LabelColumnWidth="180" />
    </StackPanel>
</Window>