<Window xmlns="clr-namespace:MGUI.Core.UI.XAML;assembly=MGUI.Core"
    Left="440" Top="20" MinHeight="0" Width="540" Height="780" TitleText="ToolTip" Padding="10">
    <Window.Styles>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style Name="Header1" TargetType="TextBlock">
            <Setter Property="IsBold" Value="True" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Height" Value="2" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Opacity" Value="0.25" />
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Background" Value="White * 0.1" />
        </Style>
    </Window.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="rgb(64,64,64)" Padding="6,3">
        <StackPanel Orientation="Vertical" Spacing="10">
            <TextBlock StyleNames="Header1" Text="ToolTip:" HorizontalAlignment="Center" />
            <Separator/>
            <TextBlock>
                ToolTips provide contextual help without adding permanent visual noise. They are useful for short hints, validation guidance and richer hover content.
            </TextBlock>
            <Separator />

            <DockPanel>
                <TextBlock Dock="Top">
                    The simplest form is a plain string assigned directly to the element's [c=Turquoise][i]ToolTip[/i][/c] property.
                </TextBlock>
                <StackPanel Orientation="Vertical" Background="White * 0.1" Padding="4" Margin="0,4,0,0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Hover me" ToolTip="This is a simple string tooltip." />
                        <Button Content="Another hint" ToolTip="Use short text for common actions." />
                    </StackPanel>
                    <TextBlock Text="Hover either button to display a default tooltip window with string content." />
                </StackPanel>
            </DockPanel>
            <Separator/>

            <DockPanel>
                <TextBlock Dock="Top">
                    For richer content, define an explicit [c=Turquoise][i]ToolTip[/i][/c] element and customize its appearance.
                </TextBlock>
                <StackPanel Orientation="Vertical" Background="White * 0.1" Padding="4" Margin="0,4,0,0" Spacing="4">
                    <Button Content="Hover for custom tooltip" HorizontalAlignment="Left">
                        <Button.ToolTip>
                            <ToolTip SizeToContent="WidthAndHeight" Padding="8,5" Background="rgb(28,41,69)" TextForeground="rgb(236,241,255)">
                                <StackPanel Orientation="Vertical" Spacing="2">
                                    <TextBlock IsBold="True" Text="Custom tooltip" />
                                    <TextBlock Text="You can place multiple elements here, including formatted text." />
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <TextBlock Text="This version is useful for onboarding text, compact help panels or annotated previews." />
                </StackPanel>
            </DockPanel>
            <Separator/>

            <DockPanel>
                <TextBlock Dock="Top">
                    ToolTips are not limited to buttons. Any interactive or informational element can expose one.
                </TextBlock>
                <Grid Background="White * 0.1" Padding="6" Margin="0,4,0,0" RowLengths="auto,auto" ColumnLengths="auto,*" RowSpacing="6" ColumnSpacing="10">
                    <Border Row="0" Column="0" Width="48" Height="48" Background="rgb(140,88,28)" ToolTip="This swatch previews a warning color." />
                    <TextBlock Row="0" Column="1" VerticalAlignment="Center" Text="Hover the colored swatch to see a tooltip on a non-button element." />

                    <TextBlock Row="1" Column="0" ColumnSpan="2" ToolTip="Tooltips also work on text-only elements." Text="Hover this line too if you want a final quick check." />
                </Grid>
            </DockPanel>
            <Separator/>

        </StackPanel>
    </ScrollViewer>
</Window>