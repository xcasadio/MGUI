<Window xmlns="clr-namespace:MGUI.Core.UI.XAML;assembly=MGUI.Core"
        xmlns:dataBinding="clr-namespace:MGUI.Core.UI.DataBinding;assembly=MGUI.Core"
        Left="20" Top="20" Width="400" SizeToContent="Height" TitleText="[Image=Computer 16x16] Compendium" Padding="10" IsUserResizable="False">
    <Window.Styles>
        <Style Name="Header1" TargetType="TextBlock">
            <Setter Property="IsBold" Value="True" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Height" Value="2" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Opacity" Value="0.25" />
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Background" Value="White * 0.1" />
        </Style>
        <Style TargetType="UniformGrid">
            <Setter Property="RowSpacing" Value="5" />
            <Setter Property="ColumnSpacing" Value="5" />
            <Setter Property="CellSize" Value="104,24" />
        </Style>
    </Window.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="rgb(64,64,64)" Padding="6,3">
        <StackPanel Orientation="Vertical" Spacing="10" Margin="2">

            <TextBlock FontSize="10" Text="Developer note: The transparent ones aren't implemented yet. Will add more samples and documentation soon... probably..." />

            <!-- Controls -->
            <Expander IsExpanded="True">
                <Expander.Header>
                    <TextBlock StyleNames="Header1" Text="Controls" />
                </Expander.Header>
                <StackPanel Orientation="Vertical" Spacing="4" Margin="20,0,0,0">
                    <TextBlock FontSize="10" Text="These samples demonstrate usage of some common elements (controls):" />
                    <UniformGrid Columns="3" AutoAssignCells="True">
                        <UniformGrid.Styles>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="10" />
                            </Style>
                        </UniformGrid.Styles>
                        <ToggleButton Content="Button" IsChecked="{dataBinding:MGBinding Path=ButtonSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="Canvas" IsChecked="{dataBinding:MGBinding Path=CanvasSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="CheckBox" IsChecked="{dataBinding:MGBinding Path=CheckBoxSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="ColorPicker" IsChecked="{dataBinding:MGBinding Path=ColorPickerSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="ComboBox" IsChecked="{dataBinding:MGBinding Path=ComboBoxSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="ContextMenu" IsChecked="{dataBinding:MGBinding Path=ContextMenuSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="ContextualContentPresenter" IsChecked="{dataBinding:MGBinding Path=ContextualContentPresenterSamples.IsVisible, Mode=TwoWay}" 
                                      ToolTip="ContextualContentPresenter" />
                        <ToggleButton Content="DockPanel" IsChecked="{dataBinding:MGBinding Path=DockPanelSamples.IsVisible, Mode=TwoWay}"/>
                        <ToggleButton Content="Expander" IsChecked="{dataBinding:MGBinding Path=ExpanderSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="Grid" IsChecked="{dataBinding:MGBinding Path=GridSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="GridColorPicker" IsChecked="{dataBinding:MGBinding Path=GridColorPickerSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="GroupBox" IsChecked="{dataBinding:MGBinding Path=GroupBoxSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="Image" IsChecked="{dataBinding:MGBinding Path=ImageSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="DataGridLite" IsChecked="{dataBinding:MGBinding Path=DataGridLiteSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="ListBox" IsChecked="{dataBinding:MGBinding Path=ListBoxSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="ListView" IsChecked="{dataBinding:MGBinding Path=ListViewSamples.IsVisible, Mode=TwoWay}" />
						<ToggleButton Content="MenuBar" IsChecked="{dataBinding:MGBinding Path=MenuBarSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="NumericUpDown" IsChecked="{dataBinding:MGBinding Path=NumericUpDownSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="Overlays" IsChecked="{dataBinding:MGBinding Path=OverlaySamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="PasswordBox" IsChecked="{dataBinding:MGBinding Path=PasswordBoxSamples.IsVisible, Mode=TwoWay}" Opacity="0.25" />
                        <ToggleButton Content="ProgressBar" IsChecked="{dataBinding:MGBinding Path=ProgressBarSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="ProgressButton" IsChecked="{dataBinding:MGBinding Path=ProgressButtonSamples.IsVisible, Mode=TwoWay}" />
						<ToggleButton Content="PropertyGrid" IsChecked="{dataBinding:MGBinding Path=PropertyGridSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="RadioButton" IsChecked="{dataBinding:MGBinding Path=RadioButtonSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="ScrollViewer" IsChecked="{dataBinding:MGBinding Path=ScrollViewerSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="Slider" IsChecked="{dataBinding:MGBinding Path=SliderSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="StackPanel" IsChecked="{dataBinding:MGBinding Path=StackPanelSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="WrapPanel" IsChecked="{dataBinding:MGBinding Path=WrapPanelSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="TabControl" IsChecked="{dataBinding:MGBinding Path=TabControlSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="TextBlock" IsChecked="{dataBinding:MGBinding Path=TextBlockSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="TextBox" IsChecked="{dataBinding:MGBinding Path=TextBoxSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="ToolTip" IsChecked="{dataBinding:MGBinding Path=ToolTipSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="TreeView" IsChecked="{dataBinding:MGBinding Path=TreeViewSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="UniformGrid" IsChecked="{dataBinding:MGBinding Path=UniformGridSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="Window" IsChecked="{dataBinding:MGBinding Path=WindowSamples.IsVisible, Mode=TwoWay}" Opacity="0.25" />
                    </UniformGrid>
                </StackPanel>
            </Expander>
            
            <!-- Features -->
            <Expander IsExpanded="True">
                <Expander.Header>
                    <TextBlock StyleNames="Header1" Text="Features" />
                </Expander.Header>
                <StackPanel Orientation="Vertical" Spacing="4" Margin="20,0,0,0">
                    <TextBlock FontSize="10" Text="These samples describe some of the common features that [i]MGUI[/i] supports:" />
                    <UniformGrid Columns="3" AutoAssignCells="True">
                        <UniformGrid.Styles>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="10" />
                            </Style>
                        </UniformGrid.Styles>
                        <ToggleButton Content="XAML" Opacity="0.25" />
                        <ToggleButton Content="Styles" IsChecked="{dataBinding:MGBinding Path=StylesSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="DataBindings" IsChecked="{dataBinding:MGBinding Path=DataBindingSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="Theme" IsChecked="{dataBinding:MGBinding Path=StyleThemeRefactorSample.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="Native Dark Preview" IsChecked="{dataBinding:MGBinding Path=NativeDarkThemePreviewSample.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="Editor Compact" IsChecked="{dataBinding:MGBinding Path=EditorCompactPresetSample.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="Animation" IsChecked="{dataBinding:MGBinding Path=AnimationDemoSample.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="RichTextBox Editor" IsChecked="{dataBinding:MGBinding Path=EditorRichTextBoxSample.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="VisualState" Opacity="0.25" />
                        <ToggleButton Content="BorderBrush" IsChecked="{dataBinding:MGBinding Path=IBorderBrushSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="FillBrush" IsChecked="{dataBinding:MGBinding Path=IFillBrushSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="Adorner Lite" IsChecked="{dataBinding:MGBinding Path=AdornerLiteSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="Text Surface Lite" IsChecked="{dataBinding:MGBinding Path=TextSurfaceLiteSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="Rounded Shapes" IsChecked="{dataBinding:MGBinding Path=RoundedShapesSamples.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="Responsive Layout" IsChecked="{dataBinding:MGBinding Path=ResponsiveLayoutSample.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="Focus/Input Review" IsChecked="{dataBinding:MGBinding Path=FocusInputReviewSample.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="Dialogue Graph" IsChecked="{dataBinding:MGBinding Path=GraphViewDialogueSample.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="Docking Demo" IsChecked="{dataBinding:MGBinding Path=DockingDemo.IsVisible, Mode=TwoWay}" />
                    </UniformGrid>
                </StackPanel>
            </Expander>

            <!-- Dialogs -->
            <Expander IsExpanded="True">
                <Expander.Header>
                    <TextBlock StyleNames="Header1" Text="Dialogs" />
                </Expander.Header>
                <StackPanel Orientation="Vertical" Spacing="4" Margin="20,0,0,0">
                    <TextBlock FontSize="10" Text="These samples showcase dialogs created with [i]MGUI[/i]:" />
                    <UniformGrid Columns="3" AutoAssignCells="True">
                        <UniformGrid.Styles>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="10" />
                            </Style>
                        </UniformGrid.Styles>
                        <ToggleButton Content="FF7 Inventory" IsChecked="{dataBinding:MGBinding Path=FF7Inventory.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="Stardew Valley" IsChecked="{dataBinding:MGBinding Path=SDVInventory.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="Registration" IsChecked="{dataBinding:MGBinding Path=Registration.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="HUD" IsChecked="{dataBinding:MGBinding Path=HUD.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="XAML Designer" IsChecked="{dataBinding:MGBinding Path=XAMLDesignerWindow.IsVisible, Mode=TwoWay}" />
                        <ToggleButton Content="Debug1" IsChecked="{dataBinding:MGBinding Path=Debug1.IsVisible, Mode=TwoWay}" TextForeground="Yellow" Opacity="0.7" />
                        <ToggleButton Content="Debug2" IsChecked="{dataBinding:MGBinding Path=Debug2.IsVisible, Mode=TwoWay}" TextForeground="Yellow" Opacity="0.7" />
                    </UniformGrid>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Window>