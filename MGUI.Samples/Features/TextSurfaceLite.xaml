<Window xmlns="clr-namespace:MGUI.Core.UI.XAML;assembly=MGUI.Core"
        Left="900" Top="70" Width="860" Height="560" TitleText="Text Surface Lite" Padding="0">
    <Window.Styles>
        <Style Name="Header1" TargetType="TextBlock">
            <Setter Property="IsBold" Value="True" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="White * 0.08" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="IsExpandable" Value="False" />
        </Style>
    </Window.Styles>

    <OverlayPanel Background="rgb(26,30,36)">
        <StackPanel Orientation="Vertical" Spacing="10" Margin="16">
            <TextBlock StyleNames="Header1" Text="Targeted text surfaces for chat, log and annotations" />
            <TextBlock Text="This sample keeps the text scope intentionally compact: explicit runs for annotated runtime text, a lightweight append-only log view, and optional inline formatting in chat message bodies." />

            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Name="AppendWarningButton" Content="Append Warning" />
                <Button Name="AppendSuccessButton" Content="Append Success" />
                <Button Name="RefreshRunsButton" Content="Refresh Annotated Runs" />
                <Button Name="AppendChatMessageButton" Content="Send Annotated Chat" />
            </StackPanel>

            <UniformGrid Columns="2" AutoAssignCells="True" CellSize="400,180" ColumnSpacing="12" RowSpacing="12">
                <GroupBox Header="Annotated Text">
                    <ContentPresenter Name="AnnotatedTextHost" />
                </GroupBox>

                <GroupBox Header="Chat Feed">
                    <ContentPresenter Name="ChatHost" />
                </GroupBox>
            </UniformGrid>

            <GroupBox Header="Log / Console">
                <ContentPresenter Name="LogHost" />
            </GroupBox>
        </StackPanel>
    </OverlayPanel>
</Window>