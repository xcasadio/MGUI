<Window xmlns="clr-namespace:MGUI.Core.UI.XAML;assembly=MGUI.Core"
        Left="440" Top="20" MinHeight="0" Width="600" Height="800" TitleText="Animation" Padding="10">
    <Window.Styles>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style Name="Header1" TargetType="TextBlock">
            <Setter Property="IsBold" Value="True" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Height" Value="2" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Opacity" Value="0.25" />
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Background" Value="White * 0.1" />
        </Style>
        <Style Name="LayoutRow" TargetType="Border">
            <Setter Property="LayoutTransitionDuration" Value="0.3" />
            <Setter Property="LayoutTransitionEasing" Value="CubicOut" />
            <Setter Property="Background" Value="rgb(48,48,48)" />
            <Setter Property="Padding" Value="4,3" />
        </Style>
    </Window.Styles>

    <ScrollViewer Name="RootScrollViewer" VerticalScrollBarVisibility="Auto" Background="rgb(64,64,64)" Padding="6,3">
        <StackPanel Orientation="Vertical" Spacing="10">
            <TextBlock StyleNames="Header1" Text="Animation:" HorizontalAlignment="Center" />
            <Separator/>
            <TextBlock>
                MGUI's animation engine drives [c=Turquoise][i]transitions[/i][/c] (automatic interpolation of every write to a property),
                [c=Turquoise][i]explicit animations[/i][/c] started from code, [c=Turquoise][i]storyboards[/i][/c] and
                [c=Turquoise][i]keyframes[/i][/c], and animatable [c=Turquoise][i]brushes[/i][/c] -- all driven by one desktop clock.
                Every section below explains one capability and demonstrates it live.
            </TextBlock>
            <Separator/>

            <!-- 1. Transitions -->
            <TextBlock StyleNames="Header1" Text="1. Transitions" />
            <TextBlock>
                A [c=Turquoise][i]Transition[/i][/c] interpolates every write to its [c=Turquoise][i]Property[/i][/c] automatically:
                [c=Turquoise][i]Duration[/i][/c], [c=Turquoise][i]Easing[/i][/c] (a name or a CSS [c=Turquoise][i]cubic-bezier(x1,y1,x2,y2)[/i][/c]
                literal) and an optional [c=Turquoise][i]Delay[/i][/c] before it starts. A write while the transition is still running
                retargets it from its current animated value, never from a jump.
            </TextBlock>
            <StackPanel Background="White * 0.1" Padding="4" Spacing="6">
                <Button Name="TransitionsHoverButton" Content="Hover me" MinHeight="36" RenderScale="1.08" Background="#3D6C9E" HorizontalAlignment="Left">
                    <Button.RenderTransform>
                        <RenderTransform Origin="0.5,0.5" />
                    </Button.RenderTransform>
                    <Button.Transitions>
                        <Transition Property="RenderScale" Duration="0.12" Easing="CubicOut" />
                        <Transition Property="Background" Duration="0.4" Easing="cubic-bezier(0.42,0,0.58,1)" Delay="0.05" />
                    </Button.Transitions>
                </Button>
                <Button Name="TransitionsRetargetButton" Content="Cycle background (retargets mid-run)" MinHeight="30" HorizontalAlignment="Left" />
            </StackPanel>
            <Separator/>

            <!-- 2. Explicit animations and the fluent API -->
            <TextBlock StyleNames="Header1" Text="2. Explicit animations and the fluent API" />
            <TextBlock>
                [c=Turquoise][i]element.Animate(path, from, to, seconds)[/i][/c] builds and starts a [c=Turquoise][i]UIPropertyAnimation[/i][/c];
                [c=Turquoise][i].Ease(...)[/i][/c], [c=Turquoise][i].AutoReverse()[/i][/c], [c=Turquoise][i].Repeat(n)[/i][/c] and
                [c=Turquoise][i].Then(...)[/i][/c]/[c=Turquoise][i].Wait(...)[/i][/c] configure it or chain a sequence. Only one animation can
                run per (element, path): a new one cancels the previous with its [c=Turquoise][i]CancelBehavior[/i][/c]; a completed run keeps
                its [c=Turquoise][i]FillBehavior[/i][/c] (hold the end value, or restore the base).
            </TextBlock>
            <StackPanel Background="White * 0.1" Padding="4" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Name="FluentFadeButton" Content="Fade" />
                    <Button Name="FluentBounceButton" Content="Bounce" />
                    <Button Name="FluentSequenceButton" Content="Sequence" />
                    <Button Name="FluentCancelButton" Content="Cancel" />
                </StackPanel>
                <Border Name="FluentTarget" Width="120" Height="50" Background="#C0392B" CornerRadius="8" HorizontalAlignment="Left">
                    <Border.RenderTransform>
                        <RenderTransform Origin="0.5,0.5" />
                    </Border.RenderTransform>
                </Border>
            </StackPanel>
            <Separator/>

            <!-- 3. Render transform and state scale -->
            <TextBlock StyleNames="Header1" Text="3. Render transform and state scale" />
            <TextBlock>
                [c=Turquoise][i]RenderTransform[/i][/c] carries [c=Turquoise][i]Translation[/i][/c], [c=Turquoise][i]Scale[/i][/c],
                [c=Turquoise][i]Rotation[/i][/c] (degrees) and an [c=Turquoise][i]Origin[/i][/c] (relative to the element's own bounds,
                [c=LightBlue][s=Blue]0.5,0.5[/s][/c] is the centre); it never affects layout. [c=Turquoise][i]RenderScale[/i][/c] is a
                separate, state-driven scale (hover/press) always applied around the element's centre regardless of [c=Turquoise][i]Origin[/i][/c].
            </TextBlock>
            <StackPanel Background="White * 0.1" Padding="4" Spacing="6">
                <Border Name="TransformTarget" Width="80" Height="50" Background="#8E44AD" CornerRadius="8" HorizontalAlignment="Left">
                    <Border.RenderTransform>
                        <RenderTransform Origin="0.5,0.5" />
                    </Border.RenderTransform>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Rotation" VerticalAlignment="Center" MinWidth="55" />
                    <Slider Name="TransformRotationSlider" Minimum="0" Maximum="360" Value="0" Width="160" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Scale" VerticalAlignment="Center" MinWidth="55" />
                    <Slider Name="TransformScaleSlider" Minimum="0.5" Maximum="2" Value="1" Width="160" />
                </StackPanel>
                <Button Name="TransformHoverButton" Content="Hover me (RenderScale)" MinHeight="32" RenderScale="1.1" HorizontalAlignment="Left" />
            </StackPanel>
            <Separator/>

            <!-- 4. Clock -->
            <TextBlock StyleNames="Header1" Text="4. Clock" />
            <TextBlock>
                [c=Turquoise][i]Desktop.Animations.Clock[/i][/c] exposes [c=Turquoise][i]IsPaused[/i][/c] and [c=Turquoise][i]TimeScale[/i][/c];
                every transition, explicit animation and engine-driven run (highlight, typewriter, [c=Turquoise][i]ProgressButton[/i][/c])
                advances through it, so pausing or slowing the clock affects all of them at once.
            </TextBlock>
            <StackPanel Background="White * 0.1" Padding="4" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ToggleButton Name="ClockPauseToggle" Content="Pause clock" />
                    <TextBlock Name="ClockActiveCountText" Text="Active animations: 0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="TimeScale" VerticalAlignment="Center" MinWidth="65" />
                    <Slider Name="ClockTimeScaleSlider" Minimum="0.25" Maximum="3" Value="1" Width="160" />
                </StackPanel>
            </StackPanel>
            <Separator/>

            <!-- 5. Composition -->
            <TextBlock StyleNames="Header1" Text="5. Composition" />
            <TextBlock>
                A [c=Turquoise][i]UIStoryboard[/i][/c] starts every child at once, in parallel; a [c=Turquoise][i]UISequenceAnimation[/i][/c]
                (or [c=Turquoise][i].Then(...)[/i][/c]) starts each child where the previous one ends, with a [c=Turquoise][i]UIDelayAnimation[/i][/c]
                (or [c=Turquoise][i].Wait(...)[/i][/c]) as a pause with no target. A child can be preset to run on a different element than the
                one the composite is started on.
            </TextBlock>
            <StackPanel Background="White * 0.1" Padding="4" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Name="CompositionTargetA" Width="70" Height="50" Background="#16A085" CornerRadius="6">
                        <Border.RenderTransform>
                            <RenderTransform Origin="0.5,0.5" />
                        </Border.RenderTransform>
                    </Border>
                    <Border Name="CompositionTargetB" Width="70" Height="50" Background="#2980B9" CornerRadius="6">
                        <Border.RenderTransform>
                            <RenderTransform Origin="0.5,0.5" />
                        </Border.RenderTransform>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Name="CompositionStoryboardButton" Content="Play storyboard" />
                    <Button Name="CompositionSequenceButton" Content="Play sequence" />
                </StackPanel>
            </StackPanel>
            <Separator/>

            <!-- 6. Keyframes and clip -->
            <TextBlock StyleNames="Header1" Text="6. Keyframes and clip" />
            <TextBlock>
                A [c=Turquoise][i]UIKeyFrameTrack[/i][/c] holds keys sorted by offset in [c=LightBlue][s=Blue]0..1[/s][/c], each with its own
                easing for the segment ending on it. [c=Turquoise][i]UIKeyFrameClipSerializer[/i][/c] serialises a whole storyboard of
                keyframe tracks for one element as JSON, shown below.
            </TextBlock>
            <StackPanel Background="White * 0.1" Padding="4" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Name="KeyframesPopButton" Content="Play keyframes" />
                    <Border Name="KeyframesTarget" Width="70" Height="50" Background="#E67E22" CornerRadius="6">
                        <Border.RenderTransform>
                            <RenderTransform Origin="0.5,0.5" />
                        </Border.RenderTransform>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Name="ClipPlayButton" Content="Load clip" />
                    <Border Name="ClipTarget" Width="90" Height="50" Background="#000000" CornerRadius="6" Opacity="0">
                        <Border.RenderTransform>
                            <RenderTransform Origin="0.5,0.5" />
                        </Border.RenderTransform>
                    </Border>
                </StackPanel>
                <TextBox Name="ClipJsonText" IsReadonly="True" AcceptsReturn="True" MinHeight="60" WrapText="True" FontSize="9" />
            </StackPanel>
            <Separator/>

            <!-- 7. Named visual states -->
            <TextBlock StyleNames="Header1" Text="7. Named visual states" />
            <TextBlock>
                An element's [c=Turquoise][i]VisualStates[/i][/c] declare setters per state name ([c=Turquoise][i]Hover[/i][/c],
                [c=Turquoise][i]Pressed[/i][/c], [c=Turquoise][i]Checked[/i][/c]...); a [c=Turquoise][i]Transition[/i][/c] on the same path
                interpolates the change. By default a state's setter (precedence 70) loses to a local value (90);
                [c=Turquoise][i]OverridesLocalValue[/i][/c] raises it to precedence 95, above local values but still below a running
                animation. A toggle's [c=Turquoise][i]CheckedBackgroundBrush[/i][/c] is a real, code-only slot distinct from the theme's
                [c=LightBlue][s=Blue]Selected[/s][/c] look.
            </TextBlock>
            <StackPanel Background="White * 0.1" Padding="4" Spacing="6">
                <ToggleButton Name="StatesToggle" Content="Hover, press or check me" MinWidth="170" MinHeight="36" HorizontalAlignment="Left">
                    <ToggleButton.RenderTransform>
                        <RenderTransform Origin="0.5,0.5" />
                    </ToggleButton.RenderTransform>
                    <ToggleButton.VisualStates>
                        <VisualStateDefinition Name="Hover">
                            <Setter Property="RenderTransform.Scale" Value="1.05" />
                        </VisualStateDefinition>
                        <VisualStateDefinition Name="Pressed">
                            <Setter Property="RenderTransform.Scale" Value="0.95" />
                        </VisualStateDefinition>
                        <VisualStateDefinition Name="Checked">
                            <Setter Property="Background" Value="#27AE60" />
                        </VisualStateDefinition>
                    </ToggleButton.VisualStates>
                    <ToggleButton.Transitions>
                        <Transition Property="RenderTransform.Scale" Duration="0.1" Easing="CubicOut" />
                        <Transition Property="Background" Duration="0.15" Easing="QuadOut" />
                    </ToggleButton.Transitions>
                </ToggleButton>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Overriding: wins on hover" FontSize="9" />
                        <Button Name="StatesOverridingPanel" Content="Hover me" MinWidth="120" MinHeight="32" Background="#3D6C9E">
                            <Button.VisualStates>
                                <VisualStateDefinition Name="Hover" OverridesLocalValue="True">
                                    <Setter Property="Background" Value="#27AE60" />
                                </VisualStateDefinition>
                            </Button.VisualStates>
                        </Button>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Plain: local value wins" FontSize="9" />
                        <Button Name="StatesPlainPanel" Content="Hover me" MinWidth="120" MinHeight="32" Background="#3D6C9E">
                            <Button.VisualStates>
                                <VisualStateDefinition Name="Hover">
                                    <Setter Property="Background" Value="#27AE60" />
                                </VisualStateDefinition>
                            </Button.VisualStates>
                        </Button>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ToggleButton Name="StatesCheckedToggle" Content="Checked brush (code)" MinWidth="140" MinHeight="32" />
                    <ToggleButton Name="StatesPlainToggle" Content="No checked brush" MinWidth="140" MinHeight="32" />
                </StackPanel>
            </StackPanel>
            <Separator/>

            <!-- 8. Styles and theme -->
            <TextBlock StyleNames="Header1" Text="8. Styles and theme" />
            <TextBlock>
                A [c=Turquoise][i]Style[/i][/c]'s [c=Turquoise][i]Style.Transitions[/i][/c] and [c=Turquoise][i]Style.VisualStates[/i][/c]
                apply to every element that references it by name; [c=Turquoise][i]MGElement.RefreshStyles()[/i][/c] re-applies a style
                after it changed (a transition in progress keeps its current value, a matched state re-applies its new setters). The theme's
                [c=Turquoise][i]MGTheme.Animation[/i][/c] group times the built-in hover/press transitions every [c=Turquoise][i]Button[/i][/c]
                and [c=Turquoise][i]ToggleButton[/i][/c] attaches when [c=Turquoise][i]Enabled[/i][/c] is set.
            </TextBlock>
            <StackPanel Background="White * 0.1" Padding="4" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Name="StylesButtonA" Content="Styled A" StyleNames="StylesSharedStyle" MinWidth="90" MinHeight="32">
                        <Button.RenderTransform>
                            <RenderTransform Origin="0.5,0.5" />
                        </Button.RenderTransform>
                    </Button>
                    <Button Name="StylesButtonB" Content="Styled B" StyleNames="StylesSharedStyle" MinWidth="90" MinHeight="32">
                        <Button.RenderTransform>
                            <RenderTransform Origin="0.5,0.5" />
                        </Button.RenderTransform>
                    </Button>
                </StackPanel>
                <Button Name="StylesRefreshButton" Content="Refresh styles (toggle hover scale)" MinWidth="220" HorizontalAlignment="Left" />
                <Button Name="StylesThemeAnimationButton" Content="Theme animation: off" MinWidth="220" HorizontalAlignment="Left" />
            </StackPanel>
            <Separator/>

            <!-- 9. Animatable brushes -->
            <TextBlock StyleNames="Header1" Text="9. Animatable brushes" />
            <TextBlock>
                A frozen brush ([c=Turquoise][i]IsFrozen[/i][/c]) is immutable, shared data (a theme, a palette entry, a
                [c=Turquoise][i]StaticResource[/i][/c]); animating it clones it once when the run starts and mutates only that clone, so a
                shared frozen brush stays untouched for every element that is not itself animating. An unfrozen brush is owned by its
                element and can be mutated directly ([c=Turquoise][i]brush.Color = ...[/i][/c] repaints on the next frame).
            </TextBlock>
            <StackPanel Background="White * 0.1" Padding="4" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Name="BrushesSharedLeftButton" Content="Shared left" MinWidth="95" MinHeight="32" />
                    <Button Name="BrushesSharedRightButton" Content="Shared right" MinWidth="95" MinHeight="32" />
                    <Button Name="BrushesAnimateLeftButton" Content="Animate left only" MinWidth="120" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Inline brush colour" VerticalAlignment="Center" MinWidth="105" />
                    <Slider Name="BrushesInlineSlider" Minimum="0" Maximum="1" Value="0" Width="140" />
                    <Border Name="BrushesInlineTarget" Width="36" Height="22" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Name="BrushesGradientButton" Content="Animate gradient" />
                    <Border Name="BrushesGradientTarget" Width="80" Height="28" />
                    <Button Name="BrushesBorderButton" Content="Animate border" />
                    <Border Name="BrushesBorderTarget" Width="50" Height="28" BorderThickness="3" />
                </StackPanel>
            </StackPanel>
            <Separator/>

            <!-- 10. Highlight -->
            <TextBlock StyleNames="Header1" Text="10. Highlight" />
            <TextBlock>
                [c=Turquoise][i]MGHighlightBorderBrush[/i][/c] is a freezable border configuration ([c=Turquoise][i]Pulse[/i][/c],
                [c=Turquoise][i]Flash[/i][/c], [c=Turquoise][i]Progress[/i][/c], [c=Turquoise][i]Scan[/i][/c]). When it is an element's
                effective border and [c=Turquoise][i]AutoStart[/i][/c] is [c=LightBlue][s=Blue]true[/s][/c] (the default), the element hosts
                its own [c=Turquoise][i]RepeatForever[/i][/c] run of [c=Turquoise][i]CycleDuration[/i][/c]. [c=Turquoise][i]AutoStart[/i][/c]
                = [c=LightBlue][s=Blue]false[/s][/c] leaves it still until the application animates
                [c=Turquoise][i]BorderBrush.Highlight.Progress[/i][/c] itself. [c=Turquoise][i]StopOnMouseOver[/i][/c] /
                [c=Turquoise][i]StopOnClick[/i][/c] stop only that element's own clone; [c=Turquoise][i]ResumeBorderHighlight()[/i][/c] restarts it.
            </TextBlock>
            <StackPanel Background="White * 0.1" Padding="4" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Name="HighlightAutoBorder" Width="90" Height="40" BorderThickness="3" CornerRadius="4" Background="#1F2933" />
                    <Border Name="HighlightManualBorder" Width="90" Height="40" BorderThickness="3" CornerRadius="4" Background="#1F2933" />
                    <Button Name="HighlightStartStopButton" Content="Start/Stop" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Name="HighlightStopOnHoverBorder" Width="90" Height="40" BorderThickness="3" CornerRadius="4" Background="#1F2933" />
                    <Button Name="HighlightResumeButton" Content="Resume" />
                </StackPanel>
            </StackPanel>
            <Separator/>

            <!-- 11. Preview and seek -->
            <TextBlock StyleNames="Header1" Text="11. Preview and seek" />
            <TextBlock>
                [c=Turquoise][i]UIAnimationPreview.Attach[/i][/c] begins an animation for an external host (a timeline scrubber) without
                registering it with the live [c=Turquoise][i]UIAnimationManager[/i][/c]: nothing is added to
                [c=Turquoise][i]Desktop.Animations.ActiveCount[/i][/c]. [c=Turquoise][i]Seek(elapsed)[/i][/c] positions it at an instant
                without firing any event; [c=Turquoise][i]Detach[/i][/c] (an alias for [c=Turquoise][i]Cancel[/i][/c]) is the only way to end it.
            </TextBlock>
            <StackPanel Background="White * 0.1" Padding="4" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Name="PreviewTarget" Width="90" Height="50" Background="#000000" CornerRadius="6" Opacity="0">
                        <Border.RenderTransform>
                            <RenderTransform Origin="0.5,0.5" />
                        </Border.RenderTransform>
                    </Border>
                    <StackPanel Spacing="4" HorizontalAlignment="Stretch">
                        <Slider Name="PreviewSlider" Minimum="0" Maximum="100" Value="0" />
                        <Button Name="PreviewDetachButton" Content="Detach" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <Separator/>

            <!-- 12. Serialisation -->
            <TextBlock StyleNames="Header1" Text="12. Serialisation" />
            <TextBlock>
                [c=Turquoise][i]UIAnimationSerializer[/i][/c] serialises a whole animation tree (storyboards, sequences, delays, property and
                keyframe animations) to JSON, with no reference of its own to any element; a [c=Turquoise][i]nameOf[/i][/c] delegate names a
                node's preset element on save, a [c=Turquoise][i]resolveElement[/i][/c] delegate resolves it back on load.
            </TextBlock>
            <StackPanel Background="White * 0.1" Padding="4" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Name="SerializationSaveButton" Content="Save" />
                    <Button Name="SerializationLoadButton" Content="Load + play" />
                </StackPanel>
                <Border Name="SerializationTarget" Width="90" Height="50" Background="#8E44AD" CornerRadius="6" Opacity="0">
                    <Border.RenderTransform>
                        <RenderTransform Origin="0.5,0.5" />
                    </Border.RenderTransform>
                </Border>
                <TextBox Name="SerializationJsonText" IsReadonly="True" AcceptsReturn="True" MinHeight="60" WrapText="True" FontSize="9" />
            </StackPanel>
            <Separator/>

            <!-- 13. Controls on the engine -->
            <TextBlock StyleNames="Header1" Text="13. Controls on the engine" />
            <TextBlock>
                [c=Turquoise][i]ProgressButton.Duration[/i][/c] and [c=Turquoise][i]TextBlock.TextCharactersPerSecond[/i][/c] (the typewriter
                reveal) both run their own animation through [c=Turquoise][i]Desktop.Animations.Clock[/i][/c], so pausing or slowing the clock
                (section 4) pauses or slows them too. Writing [c=Turquoise][i]TextProgress = 0[/i][/c] replays a completed or in-progress reveal.
            </TextBlock>
            <StackPanel Background="White * 0.1" Padding="4" Spacing="6">
                <ProgressButton Name="EngineProgressButton" Content="Click: 3 s on the engine" MinWidth="200" MinHeight="36" Duration="0:0:3" ProgressBarForeground="#2980B9" HorizontalAlignment="Left" />
                <TextBlock Name="TypewriterText" Text="This text reveals itself over the desktop's animation clock." WrapText="True" />
                <Button Name="EngineReplayButton" Content="Replay" HorizontalAlignment="Left" />
            </StackPanel>
            <Separator/>

            <!-- 14. Diagnostics -->
            <TextBlock StyleNames="Header1" Text="14. Diagnostics" />
            <TextBlock>
                [c=Turquoise][i]UIToolingService.CaptureElementDebugView[/i][/c] lists an element's active and held animations and its
                [c=Turquoise][i]ApplicablePaths[/i][/c] (the animation paths it accepts). "Measure per-tick allocations" reports
                [c=Turquoise][i]GC.GetAllocatedBytesForCurrentThread[/i][/c] over the whole desktop update tick (not just the animation)
                averaged over 120 ticks, so this page's own [c=Turquoise][i]ClockActiveCountText[/i][/c] updates count toward it too.
            </TextBlock>
            <StackPanel Background="White * 0.1" Padding="4" Spacing="6">
                <Button Name="DiagnosticsPathsButton" Content="Show applicable paths" HorizontalAlignment="Left" />
                <TextBox Name="DiagnosticsPathsText" IsReadonly="True" AcceptsReturn="True" MinHeight="50" WrapText="True" FontSize="9" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Name="DiagnosticsMeasureButton" Content="Measure per-tick allocations" />
                    <Border Name="DiagnosticsTarget" Width="24" Height="24" Background="#3D6C9E" />
                </StackPanel>
                <TextBlock Name="DiagnosticsAllocationText" Text="Allocations per tick: not measured" />
            </StackPanel>
            <Separator/>

            <!-- 15. Awaitable animations -->
            <TextBlock StyleNames="Header1" Text="15. Awaitable animations" />
            <TextBlock>
                [c=Turquoise][i]PlayAsync[/i][/c] returns a [c=Turquoise][i]Task&lt;bool&gt;[/i][/c]: [c=Turquoise][i]true[/i][/c] once the run
                completes, [c=Turquoise][i]false[/i][/c] if it is cancelled, never an exception. The three steps below are chained with
                [c=Turquoise][i]await[/i][/c] in an [c=Turquoise][i]async[/i][/c] handler; "Cancel" cancels a
                [c=Turquoise][i]CancellationToken[/i][/c] passed to the first [c=Turquoise][i]PlayAsync[/i][/c] call.
            </TextBlock>
            <StackPanel Background="White * 0.1" Padding="4" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Name="AwaitPlayButton" Content="Play three steps" />
                    <Button Name="AwaitCancelButton" Content="Cancel" />
                </StackPanel>
                <Border Name="AwaitTarget" Width="90" Height="50" Background="#16A085" CornerRadius="8" HorizontalAlignment="Left">
                    <Border.RenderTransform>
                        <RenderTransform Origin="0.5,0.5" />
                    </Border.RenderTransform>
                </Border>
                <TextBlock Name="AwaitResultText" Text="Idle" />
            </StackPanel>
            <Separator/>

            <!-- 16. Smooth scrolling -->
            <TextBlock StyleNames="Header1" Text="16. Smooth scrolling" />
            <TextBlock>
                [c=Turquoise][i]ScrollTo[/i][/c] animates [c=Turquoise][i]VerticalOffset[/i][/c]/[c=Turquoise][i]HorizontalOffset[/i][/c] to a
                clamped destination. [c=Turquoise][i]ScrollAnimationDuration[/i][/c]/[c=Turquoise][i]ScrollAnimationEasing[/i][/c] (set below
                on the viewer itself) make the mouse wheel and keyboard navigation smooth too, following the destination rather than the
                momentary animated position. An external write -- dragging the scrollbar, for instance -- takes over immediately and keeps
                the value it wrote.
            </TextBlock>
            <StackPanel Background="White * 0.1" Padding="4" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Name="ScrollDemoTopButton" Content="Top" />
                    <Button Name="ScrollDemoBottomButton" Content="Bottom" />
                </StackPanel>
                <ScrollViewer Name="ScrollDemoViewer" Height="120" VerticalScrollBarVisibility="Auto"
                              ScrollAnimationDuration="0.25" ScrollAnimationEasing="CubicOut" Background="rgb(48,48,48)">
                    <StackPanel Orientation="Vertical" Spacing="0">
                        <TextBlock Text="Row 1" Padding="4,3" />
                        <TextBlock Text="Row 2" Padding="4,3" />
                        <TextBlock Text="Row 3" Padding="4,3" />
                        <TextBlock Text="Row 4" Padding="4,3" />
                        <TextBlock Text="Row 5" Padding="4,3" />
                        <TextBlock Text="Row 6" Padding="4,3" />
                        <TextBlock Text="Row 7" Padding="4,3" />
                        <TextBlock Text="Row 8" Padding="4,3" />
                        <TextBlock Text="Row 9" Padding="4,3" />
                        <TextBlock Text="Row 10" Padding="4,3" />
                        <TextBlock Text="Row 11" Padding="4,3" />
                        <TextBlock Text="Row 12" Padding="4,3" />
                        <TextBlock Text="Row 13" Padding="4,3" />
                        <TextBlock Text="Row 14" Padding="4,3" />
                        <TextBlock Text="Row 15" Padding="4,3" />
                        <TextBlock Text="Row 16" Padding="4,3" />
                        <TextBlock Text="Row 17" Padding="4,3" />
                        <TextBlock Text="Row 18" Padding="4,3" />
                        <TextBlock Text="Row 19" Padding="4,3" />
                        <TextBlock Text="Row 20" Padding="4,3" />
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>

            <Separator/>

            <!-- 17. Sprite-sheet frames -->
            <TextBlock StyleNames="Header1" Text="17. Sprite-sheet frames" />
            <TextBlock>
                A [c=Turquoise][i]TextureFillBrush[/i][/c] can carry a [c=Turquoise][i]FrameGrid[/i][/c] (columns, rows, cell size, spacing,
                margin): [c=Turquoise][i]FramesTarget[/i][/c]'s background is a 2x2 grid over the "AngryMeteor" sample sheet's four green arrow
                icons (16px cells, 1px spacing, top margin 6, columns 0-1 of rows 0-1 - see [c=Turquoise][i]MGDesktop.LoadDefaultResources[/i][/c]).
                [c=Turquoise][i]Background.Texture.Frame[/i][/c] animates the frame as a plain float, whose integer part selects the cell
                (floored and clamped); "Play" loops it forever, and the toggle pauses/resumes that one run in place
                ([c=Turquoise][i]UIAnimation.Pause[/i][/c]/[c=Turquoise][i]Resume[/i][/c]).
            </TextBlock>
            <StackPanel Background="White * 0.1" Padding="4" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Name="FramesPlayButton" Content="Play" />
                    <ToggleButton Name="FramesPauseToggle" Content="Pause" />
                </StackPanel>
                <Border Name="FramesTarget" Width="48" Height="48" HorizontalAlignment="Left">
                    <Border.Background>
                        <TextureFillBrush SourceName="AngryMeteor" Stretch="Uniform"
                                           FrameColumns="2" FrameRows="2" FrameCellSize="16,16" FrameSpacing="1,1" FrameMargin="0,6" />
                    </Border.Background>
                </Border>
            </StackPanel>

            <Separator/>

            <!-- 18. Layout transitions -->
            <TextBlock StyleNames="Header1" Text="18. Layout transitions" />
            <TextBlock>
                An element opts in per element or through a style ([c=Turquoise][i]LayoutTransitionDuration[/i][/c]/
                [c=Turquoise][i]LayoutTransitionEasing[/i][/c]): when a real layout pass moves it, it glides from its previous visual position
                to the new one. The neighbours that the layout moves slide to their new place; the element that is itself inserted, removed
                or moved does not slide, since it has just been attached. [c=Turquoise][i]LayoutTransitionAnimatesSize[/i][/c] stretches the
                content during a size change too.
            </TextBlock>
            <StackPanel Background="White * 0.1" Padding="4" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Name="LayoutInsertButton" Content="Insert at top" />
                    <Button Name="LayoutRemoveButton" Content="Remove first" />
                    <Button Name="LayoutMoveButton" Content="Move last to top" />
                </StackPanel>
                <StackPanel Name="LayoutListPanel" Orientation="Vertical" Spacing="4">
                    <Border StyleNames="LayoutRow"><TextBlock Text="Row 1" /></Border>
                    <Border StyleNames="LayoutRow"><TextBlock Text="Row 2" /></Border>
                    <Border StyleNames="LayoutRow"><TextBlock Text="Row 3" /></Border>
                    <Border StyleNames="LayoutRow"><TextBlock Text="Row 4" /></Border>
                </StackPanel>
                <Button Name="LayoutResizeButton" Content="Resize" HorizontalAlignment="Left" />
                <Border Name="LayoutSizeTarget" Width="100" Height="40" Background="#16A085" HorizontalAlignment="Left"
                        LayoutTransitionDuration="0.3" LayoutTransitionEasing="CubicOut" LayoutTransitionAnimatesSize="True" />
            </StackPanel>

            <Separator/>

            <!-- 19. Enter and exit -->
            <TextBlock StyleNames="Header1" Text="19. Enter and exit" />
            <TextBlock>
                [c=Turquoise][i]EnterExit[/i][/c] settings, set in code, drive an entry animation when the element becomes visible and an exit
                animation when it is hidden. The exit keeps the element visible, drawn and in the layout, but non-interactive, until it
                completes: only then is the requested visibility actually applied. Nothing plays before the element's first draw, so the panel
                below stays put at load.
            </TextBlock>
            <StackPanel Background="White * 0.1" Padding="4" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Name="EnterExitFadeButton" Content="Fade" />
                    <Button Name="EnterExitScaleButton" Content="Scale" />
                    <Button Name="EnterExitSlideButton" Content="Slide" />
                    <Button Name="EnterExitToggleButton" Content="Show/Hide" />
                </StackPanel>
                <Border Name="EnterExitTarget" Width="160" Height="60" Background="#8E44AD" HorizontalAlignment="Left">
                    <TextBlock Text="Enter/Exit" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </StackPanel>

            <Spacer Height="70" />
        </StackPanel>
    </ScrollViewer>
</Window>
