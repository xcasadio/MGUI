<Window xmlns="clr-namespace:MGUI.Core.UI.XAML;assembly=MGUI.Core"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        Left="560" Top="60" Width="820" Height="780" TitleText="Editor Compact Preset" Padding="10">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical" Spacing="8">
            <TextBlock Text="[b]Editor Compact preset[/b]" FontSize="14" />
            <TextBlock WrapText="True" Text="The preset is the theme EditorCompact (BasedOn Dark) of EditorCompact.Themes.xaml. The buttons below only change the default theme of this window's resource scope: no control code, no style and no new API." />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Name="ApplyDarkButton" Content="Dark" />
                <Button Name="ApplyCompactButton" Content="Editor Compact" />
                <TextBlock Name="ActiveThemeText" VerticalAlignment="Center" />
            </StackPanel>
            <Separator />

            <Grid RowLengths="Auto,Auto" ColumnLengths="*,*" RowSpacing="10" ColumnSpacing="12">
                <StackPanel Row="0" Column="0" Orientation="Vertical" Spacing="6">
                    <TextBlock Text="[b]Selectors, lists and trees[/b]" />
                    <ComboBox Name="SampleComboBox" ItemType="{x:Type System:String}" Width="220" HorizontalAlignment="Left">
                        <System:String>Diffuse</System:String>
                        <System:String>Normal</System:String>
                        <System:String>ORM</System:String>
                        <System:String>Emissive</System:String>
                    </ComboBox>
                    <ListBox Name="SampleListBox" ItemType="{x:Type System:String}" Width="280" Height="150" Header="Project Assets" />
                    <TreeView Width="280" Height="150">
                        <TreeViewItem Header="Scenes" IsExpanded="True">
                            <TreeViewItem Header="MainMenu.scene" />
                            <TreeViewItem Header="Warehouse.scene" />
                        </TreeViewItem>
                        <TreeViewItem Header="Materials" IsExpanded="True">
                            <TreeViewItem Header="Metal.panel.mat" />
                            <TreeViewItem Header="Stone.floor.mat" />
                        </TreeViewItem>
                    </TreeView>
                    <TextBox Text="The text box keeps its template padding and minimum height." />
                </StackPanel>

                <StackPanel Row="0" Column="1" Orientation="Vertical" Spacing="6">
                    <TextBlock Text="[b]Tabs, menus and tooltips[/b]" />
                    <TabControl Height="140">
                        <TabItem Header="Inspector">
                            <TextBlock Text="The spacing between the headers comes from the theme; the header paddings stay template values." WrapText="True" />
                        </TabItem>
                        <TabItem Header="Console">
                            <TextBlock Text="Switch the theme to compare both densities." WrapText="True" />
                        </TabItem>
                    </TabControl>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Name="OpenContextMenuButton" Content="Open Context Menu">
                            <Button.ContextMenu>
                                <ContextMenu Name="SampleContextMenu" TitleText="Asset Actions">
                                    <ContextMenuButton Content="Open" />
                                    <ContextMenuButton Content="Duplicate" />
                                    <ContextMenuButton Content="Delete" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Content="Hover For Tooltip" ToolTip="The tooltip padding and border stay catalogue literals." />
                    </StackPanel>
                    <TextBlock Text="[b]Docking[/b]" />
                    <Border Name="DockHostContainer" Height="200" BorderThickness="1" />
                </StackPanel>

                <StackPanel Row="1" Column="0" ColumnSpan="2" Orientation="Vertical" Spacing="6">
                    <TextBlock Text="[b]What the preset reaches, and what it cannot[/b]" />
                    <TextBox Name="LimitsText" Height="220" IsReadonly="True" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
