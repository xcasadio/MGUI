<Window xmlns="clr-namespace:MGUI.Core.UI.XAML;assembly=MGUI.Core"
    Width="760" Height="560" TitleText="Rounded Shapes" Padding="12" Background="rgb(34,38,43)">
    <Window.Styles>
        <Style TargetType="TextBlock">
            <Setter Property="TextForeground" Value="White" />
        </Style>
        <Style TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Background" Value="rgb(56,63,72)" />
            <Setter Property="BorderBrush" Value="rgb(96,108,122)" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
    </Window.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
        <StackPanel Orientation="Vertical" Spacing="12">
            <TextBlock FontSize="16" IsBold="True" Text="Rounded shape regression surface" />
            <TextBlock Text="This sample is intended for manual inspection of simple, uniform, asymmetric, thick-border, tiny-size, semi-transparent, and clip-pipeline rounded scenarios." />

            <Border>
                <StackPanel Orientation="Vertical" Spacing="8">
                    <TextBlock IsBold="True" Text="Rectangles" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Rectangle Width="120" Height="56" Stroke="White" StrokeThickness="2" Fill="rgb(77,163,255)" />
                        <Rectangle Width="120" Height="56" Stroke="White" StrokeThickness="2" Fill="rgb(77,163,255)" CornerRadius="12" />
                        <Rectangle Width="120" Height="56" Stroke="White" StrokeThickness="4" Fill="rgba(255,140,0,180)" CornerRadius="4,18,24,8" />
                        <Rectangle Width="56" Height="32" Stroke="White" StrokeThickness="8" Fill="rgba(0,200,160,180)" CornerRadius="16" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border>
                <StackPanel Orientation="Vertical" Spacing="8">
                    <TextBlock IsBold="True" Text="Retained shapes v1" />
                    <TextBlock Text="Ellipse, Polygon, Polyline, Line, and PathLite now share retained geometry semantics for draw, hit test, and clip adoption where the shape is closed and convex." />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Ellipse Width="110" Height="70" Stroke="White" StrokeThickness="3" Fill="rgba(77,163,255,220)" />
                        <Polygon Points="0,54 36,0 92,18 72,82 18,86" Stroke="White" StrokeThickness="3" Fill="rgba(255,140,0,210)" />
                        <PathLite Data="M 0,24 L 20,0 L 52,10 L 80,0 L 108,24 L 82,58 L 26,58 Z" Stroke="White" StrokeThickness="3" Fill="rgba(255,120,180,170)" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Polyline Points="0,42 20,10 46,34 72,0 102,42" Stroke="rgb(120,255,160)" StrokeThickness="4" />
                        <Line StartPoint="0,0" EndPoint="120,26" Stroke="rgb(255,220,120)" StrokeThickness="4" />
                        <Ellipse Width="140" Height="78" Stroke="White" StrokeThickness="3" Fill="White|Orange|Lime|HotPink" />
                    </StackPanel>

                    <TextBlock Text="Manual checks: the ellipse brush fill follows the curved silhouette, and the shapes only react over their actual stroke/fill instead of the full rectangular slot." />
                </StackPanel>
            </Border>

            <Border>
                <StackPanel Orientation="Vertical" Spacing="8">
                    <TextBlock IsBold="True" Text="Brushes" />
                    <Rectangle Width="300" Height="50" Stroke="White" StrokeThickness="3" Fill="#5AA9FF" CornerRadius="14" />
                    <Rectangle Width="300" Height="50" Stroke="White" StrokeThickness="4" Fill="White|Orange|Lime|HotPink" CornerRadius="6,18,6,18" />
                    <Border BorderBrush="#A5C8FF-#FFD17A-#FFA5A5-#9AE6B4" BorderThickness="5" CornerRadius="18" Background="rgba(255,255,255,30)">
                        <TextBlock Text="Semi-transparent fill over rounded border" />
                    </Border>
                </StackPanel>
            </Border>

            <Border>
                <StackPanel Orientation="Vertical" Spacing="8">
                    <TextBlock IsBold="True" Text="Nested controls" />
                    <Button CornerRadius="14" BorderThickness="2" BorderBrush="White" Background="rgb(77,163,255)" Padding="12,6">Rounded Button</Button>
                    <TextBox CornerRadius="10" BorderThickness="2" BorderBrush="White" Background="rgb(44,48,54)" Text="Rounded TextBox" />
                    <ComboBox CornerRadius="10" BorderThickness="2" BorderBrush="White" Background="rgb(44,48,54)" SelectedIndex="0">
                        <TextBlock Text="First option" />
                        <TextBlock Text="Second option" />
                    </ComboBox>
                    <ProgressBar CornerRadius="10" BorderThickness="2" BorderBrush="White" Width="320" Height="28" Minimum="0" Maximum="100" Value="66" />
                </StackPanel>
            </Border>

            <Border>
                <StackPanel Orientation="Vertical" Spacing="8">
                    <TextBlock IsBold="True" Text="Hit testing" />
                    <TextBlock Text="Manual checks: the left Border opts into shape-aware hit testing, so its rounded-off corners ignore the mouse (no hover highlight, no tooltip there); the right Border keeps the default rectangular hit test and still reacts over its full rectangular slot." />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="220" Height="96" CornerRadius="40" IsShapeAwareHitTestEnabled="True" Background="rgb(67,84,99)" BackgroundFocusedColor="rgba(255,255,255,70)" BorderBrush="White" BorderThickness="2" ToolTip="Shape-aware hit test: the corners ignore the mouse">
                            <TextBlock Text="IsShapeAwareHitTestEnabled = True" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Width="220" Height="96" CornerRadius="40" Background="rgb(67,84,99)" BackgroundFocusedColor="rgba(255,255,255,70)" BorderBrush="White" BorderThickness="2" ToolTip="Default rectangular hit test: the corners still react">
                            <TextBlock Text="Default (rectangular)" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border>
                <StackPanel Orientation="Vertical" Spacing="8">
                    <TextBlock IsBold="True" Text="Clip pipeline" />
                    <TextBlock Text="Manual checks: rounded parent clips oversized child content, nested rounded+rectangle combinations stay stable, scroll content remains clipped, and RenderScale still respects clip bounds." />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="220" Height="96" CornerRadius="20" ClipToBounds="True" Background="rgb(67,84,99)" BorderBrush="White" BorderThickness="2" Padding="10">
                            <StackPanel Orientation="Horizontal" Spacing="-18">
                                <Rectangle Width="88" Height="72" Fill="rgba(255,120,120,200)" CornerRadius="18" />
                                <Rectangle Width="88" Height="72" Fill="rgba(120,220,255,190)" CornerRadius="18" RenderScale="1.1" />
                                <Rectangle Width="88" Height="72" Fill="rgba(255,220,120,200)" CornerRadius="18" />
                            </StackPanel>
                        </Border>

                        <Border Width="220" Height="96" CornerRadius="0" ClipToBounds="True" Background="rgb(67,84,99)" BorderBrush="White" BorderThickness="2" Padding="10">
                            <Border Width="180" Height="72" CornerRadius="18" ClipToBounds="True" Background="rgba(120,180,255,70)" BorderBrush="rgb(120,220,255)" BorderThickness="2">
                                <Rectangle Width="220" Height="72" Fill="White|Orange|Lime|HotPink" RenderScale="1.08" />
                            </Border>
                        </Border>
                    </StackPanel>

                    <Border Width="460" Height="150" CornerRadius="18" ClipToBounds="True" Background="rgb(48,53,60)" BorderBrush="White" BorderThickness="2" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                            <StackPanel Orientation="Vertical" Spacing="8">
                                <TextBlock Text="Rounded ScrollViewer viewport clip" />
                                <Rectangle Width="420" Height="32" Fill="rgba(77,163,255,180)" CornerRadius="12" />
                                <Rectangle Width="420" Height="32" Fill="rgba(255,140,0,180)" CornerRadius="12" />
                                <Rectangle Width="420" Height="32" Fill="rgba(120,255,160,180)" CornerRadius="12" />
                                <Rectangle Width="420" Height="32" Fill="rgba(255,120,180,180)" CornerRadius="12" />
                                <Rectangle Width="420" Height="32" Fill="rgba(180,120,255,180)" CornerRadius="12" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>