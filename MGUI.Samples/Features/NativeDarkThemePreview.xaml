<Window xmlns="clr-namespace:MGUI.Core.UI.XAML;assembly=MGUI.Core"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        xmlns:controls="clr-namespace:MGUI.Samples.Controls;assembly=MGUI.Samples"
        xmlns:dataBinding="clr-namespace:MGUI.Core.UI.DataBinding;assembly=MGUI.Core"
        Left="520" Top="40" Width="860" Height="840" TitleText="Native Dark Theme Preview" Padding="10">
    <Window.Styles>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style Name="Header1" TargetType="TextBlock">
            <Setter Property="IsBold" Value="True" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Height" Value="2" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Opacity" Value="0.25" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </Window.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,3">
        <StackPanel Orientation="Vertical" Spacing="10">
            <TextBlock StyleNames="Header1" Text="MGUI Dark Preview" HorizontalAlignment="Center" />
            <TextBlock Text="This sample previews the native MGUI built-in Dark theme and its embedded control templates, without loading any theme assets from CasaEngine.Editor." WrapText="True" />
            <TextBlock Name="ThemeStatusText" WrapText="True" />
            <Separator />

            <Grid RowLengths="Auto,Auto,Auto" ColumnLengths="*,*" RowSpacing="10" ColumnSpacing="12">
                <StackPanel Row="0" Column="0" Orientation="Vertical" Spacing="8">
                    <TextBlock StyleNames="Header1" Text="Selectors and Trees" />
                    <ComboBox Name="SampleComboBox" ItemType="{x:Type System:String}" Width="220" HorizontalAlignment="Left">
                        <System:String>Diffuse</System:String>
                        <System:String>Normal</System:String>
                        <System:String>ORM</System:String>
                        <System:String>Emissive</System:String>
                    </ComboBox>
                    <ListBox Name="SampleListBox" ItemType="{x:Type System:String}" Width="280" Height="160" Header="Project Assets" />
                    <TreeView Width="280" Height="190" IndentSize="18">
                        <TreeViewItem Header="Scenes" IsExpanded="True">
                            <TreeViewItem Header="MainMenu.scene" />
                            <TreeViewItem Header="Warehouse.scene" />
                        </TreeViewItem>
                        <TreeViewItem Header="Materials" IsExpanded="True">
                            <TreeViewItem Header="Metal.panel.mat" />
                            <TreeViewItem Header="Stone.floor.mat" />
                        </TreeViewItem>
                        <TreeViewItem Header="Textures" IsExpanded="True">
                            <TreeViewItem Header="Concrete_BaseColor.png" />
                            <TreeViewItem Header="Concrete_Normal.png" />
                        </TreeViewItem>
                    </TreeView>
                </StackPanel>

                <StackPanel Row="0" Column="1" Orientation="Vertical" Spacing="8">
                    <TextBlock StyleNames="Header1" Text="Tabs, Overlay and Menus" />
                    <TabControl Height="210">
                        <TabItem Header="Inspector">
                            <TextBlock Text="The tab header chrome and active-state visuals come from the editor theme mappings." WrapText="True" />
                        </TabItem>
                        <TabItem Header="Preview">
                            <TextBlock Text="Preview surfaces intentionally remain neutral so meshes and materials stay readable." WrapText="True" />
                        </TabItem>
                        <TabItem Header="Console">
                            <TextBlock Text="Use this tab to verify spacing, borders, and text contrast in a compact workspace layout." WrapText="True" />
                        </TabItem>
                    </TabControl>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Name="OpenContextMenuButton" Content="Open Context Menu" ToolTip="Preview the editor context menu chrome.">
                            <Button.ContextMenu>
                                <ContextMenu Name="SampleContextMenu" TitleText="Asset Actions">
                                    <ContextMenuButton Content="Open" />
                                    <ContextMenuButton Content="Duplicate" />
                                    <ContextMenuButton Content="Reveal in Browser" />
                                    <ContextMenuButton Content="Delete" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Name="ToggleOverlayButton" Content="Hide Overlay" ToolTip="Toggle the overlay preview surface." />
                    </StackPanel>
                    <OverlayHost MinHeight="160" OverlayBackground="Black * 0.35" Content="Viewport content behind overlay">
                        <OverlayHost.Overlays>
                            <Overlay Name="SampleOverlay" IsOpen="True" ShowCloseButton="True" Padding="10,20,10,10" Content="Overlay preview for modal editor actions" />
                        </OverlayHost.Overlays>
                    </OverlayHost>
                    <Button Content="Hover For Tooltip" HorizontalAlignment="Left" ToolTip="Tooltips should reuse the editor tooltip window and border chrome." />
                </StackPanel>

                <StackPanel Row="1" Column="0" ColumnSpan="2" Orientation="Vertical" Spacing="8">
                    <TextBlock StyleNames="Header1" Text="ListView" />
                    <ListView Name="SampleListView" Height="190" ItemType="{x:Type controls:Person}">
                        <ListViewColumn Width="56">
                            <ListViewColumn.Header>
                                <TextBlock IsBold="True" TextAlignment="Center" Text="Id" />
                            </ListViewColumn.Header>
                            <ListViewColumn.CellTemplate>
                                <ContentTemplate>
                                    <TextBlock HorizontalAlignment="Center" Text="{dataBinding:MGBinding Path=Id, Mode=OneTime, FallbackValue='&lt;Id&gt;'}" />
                                </ContentTemplate>
                            </ListViewColumn.CellTemplate>
                        </ListViewColumn>
                        <ListViewColumn Width="*">
                            <ListViewColumn.Header>
                                <TextBlock IsBold="True" TextAlignment="Center" Text="First Name" />
                            </ListViewColumn.Header>
                        </ListViewColumn>
                        <ListViewColumn Width="*">
                            <ListViewColumn.Header>
                                <TextBlock IsBold="True" TextAlignment="Center" Text="Last Name" />
                            </ListViewColumn.Header>
                        </ListViewColumn>
                    </ListView>
                </StackPanel>

                <StackPanel Row="2" Column="0" ColumnSpan="2" Orientation="Vertical" Spacing="6">
                    <TextBlock StyleNames="Header1" Text="Loaded Assets" />
                    <TextBlock Text="This box reports the real theme/template files that were resolved from the workspace at startup." WrapText="True" />
                    <TextBox Name="AssetPathsText" Height="120" IsReadonly="True" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>